# Copy to .env (`pnpm db:setup` creates it with the values of the root .env).
# The user, password, port and database must match the root .env (Docker Postgres).
DATABASE_URL="postgresql://gwent:gwent@localhost:5433/gwent?schema=public"
PORT=3000
# Frontend (Vite) origin allowed by CORS
WEB_ORIGIN="http://localhost:5173"
