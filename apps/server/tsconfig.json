{
  "extends": "@gwent/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "strictPropertyInitialization": false
  },
  "include": ["src", "test", "prisma", "prisma.config.ts", "vitest.config.ts", "rspack.config.js"]
}
