# Local Docker infrastructure (docker-compose.yml). Copy to .env (`pnpm db:setup` does it).
# Development-only values: change them if you want, before the first `pnpm db:setup`.
# (Postgres only applies user/password/database when its volume is created; to change them later,
# run `docker compose down -v`, which erases the local database, and `pnpm db:setup` again.)
POSTGRES_USER=gwent
POSTGRES_PASSWORD=gwent
POSTGRES_DB=gwent
# Host ports (5432 is often taken by a locally installed PostgreSQL)
POSTGRES_PORT=5433
ADMINER_PORT=8080
